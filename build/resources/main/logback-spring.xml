<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- ================================================= -->
    <!-- LOG DIRECTORIES                                  -->
    <!-- ================================================= -->

    <property name="LOG_DIR" value="logs"/>

    <property name="APPLICATION_LOG_DIR"
              value="${LOG_DIR}/application"/>

    <property name="THIRD_PARTY_LOG_DIR"
              value="${LOG_DIR}/third-party"/>

    <property name="ERROR_LOG_DIR"
              value="${LOG_DIR}/error"/>


    <!-- ================================================= -->
    <!-- COMMON PATTERN                                   -->
    <!-- ================================================= -->

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss} [%X{requestId}] %-5level- %msg%n"/>


    <!-- ================================================= -->
    <!-- CONSOLE                                          -->
    <!-- ================================================= -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ================================================= -->
    <!-- APPLICATION LOG                                 -->
    <!-- ================================================= -->

    <appender name="APPLICATION_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${APPLICATION_LOG_DIR}/application.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${APPLICATION_LOG_DIR}/application.%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ================================================= -->
    <!-- THIRD PARTY API LOG                              -->
    <!-- ================================================= -->

    <appender name="THIRD_PARTY_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${THIRD_PARTY_LOG_DIR}/third-party-api.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${THIRD_PARTY_LOG_DIR}/third-party-api.%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ================================================= -->
    <!-- ERROR LOG                                        -->
    <!-- ================================================= -->

    <appender name="ERROR_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${ERROR_LOG_DIR}/error.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${ERROR_LOG_DIR}/error.%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">

            <level>ERROR</level>

        </filter>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ================================================= -->
    <!-- THIRD PARTY LOGGER                               -->
    <!-- ================================================= -->

    <logger name="THIRD_PARTY_API"
            level="INFO"
            additivity="false">

        <appender-ref ref="THIRD_PARTY_FILE"/>

        <appender-ref ref="CONSOLE"/>

    </logger>


    <!-- ================================================= -->
    <!-- ROOT LOGGER                                      -->
    <!-- ================================================= -->

    <root level="INFO">

        <appender-ref ref="CONSOLE"/>

        <appender-ref ref="APPLICATION_FILE"/>

        <appender-ref ref="ERROR_FILE"/>

    </root>

</configuration>